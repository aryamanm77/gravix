{
  "name": "gravix",
  "displayName": "Gravix",
  "description": "Multi-account quota dashboard and session switching for Antigravity IDE.",
  "version": "0.6.0",
  "publisher": "Aryaman-M",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "categories": ["Other"],
  "keywords": ["antigravity", "quota", "accounts", "model availability"],
  "extensionKind": ["ui"],
  "repository": {
    "type": "git",
    "url": "https://github.com/aryamanm77/gravix.git"
  },
  "bugs": {
    "url": "https://github.com/aryamanm77/gravix/issues"
  },
  "homepage": "https://github.com/aryamanm77/gravix#readme",
  "engines": {
    "vscode": "^1.107.0",
    "node": ">=20"
  },
  "main": "./src/extension.cjs",
  "activationEvents": [
    "onCommand:gravix.open",
    "onCommand:gravix.openGithub",
    "onView:gravix.accounts",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gravix.open",
        "title": "Gravix: Open Sidebar"
      },
      {
        "command": "gravix.refresh",
        "title": "Refresh Accounts",
        "icon": "$(refresh)"
      },
      {
        "command": "gravix.connect",
        "title": "Connect Google Account",
        "icon": "$(add)"
      },
      {
        "command": "gravix.openGithub",
        "title": "Open GitHub Repository",
        "icon": "$(github)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gravix",
          "title": "Gravix",
          "icon": "media/gravix-activitybar.svg"
        }
      ]
    },
    "views": {
      "gravix": [
        {
          "type": "webview",
          "id": "gravix.accounts",
          "name": "Accounts",
          "contextualTitle": "Gravix"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gravix.refresh",
          "when": "view == gravix.accounts",
          "group": "navigation@1"
        },
        {
          "command": "gravix.connect",
          "when": "view == gravix.accounts",
          "group": "navigation@2"
        },
        {
          "command": "gravix.openGithub",
          "when": "view == gravix.accounts",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gravix.refresh",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "focusedView == gravix.accounts"
      }
    ],
    "configuration": {
      "title": "Gravix",
      "properties": {
        "gravix.monitorBatchSize": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 10,
          "description": "Number of accounts to check in parallel when looking for a quota alternative (1–10)."
        },
        "antigravity-account-manager.monitorBatchSize": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 10,
          "description": "Legacy alias: Number of accounts to check in parallel when looking for a quota alternative (1–10)."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build-icon.cjs",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links",
    "audit:privacy": "node scripts/audit-privacy.cjs",
    "test": "node --test test/core.test.cjs test/monitor.test.cjs",
    "check": "node --check src/extension.cjs && node --check src/core.cjs && node --check src/oauth.cjs && node --check src/ide-state.cjs && node --check src/switch.cjs && node --check src/monitor.cjs && node --check src/scan.cjs && node --check src/chrome.cjs && node --check media/panel.js && node --check media/readiness.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vscode/vsce": "^4.0.0"
  }
}
